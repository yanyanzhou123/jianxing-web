---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getModule } from '../../data/content';

export function getStaticPaths() {
  return ['lunhui', 'qianxing', 'foguang', 'buli'].map((module) => ({
    params: { module },
  }));
}

const moduleSlug = Astro.params.module!;
const seed = getModule(moduleSlug);
---

<BaseLayout title={seed?.title || moduleSlug} description={seed?.summary || ''}>
  <div class="page-hero">
    <div class="wrap">
      <p class="group-label" style="margin-top: 0;" id="mod-status">学修模块</p>
      <h1 id="mod-title">《{seed?.title || '加载中…'}》</h1>
      <p id="mod-intro">{seed?.intro || seed?.summary || ''}</p>
      <p class="lesson-list__meta" id="mod-meta" style="margin-top: 0.75rem;"></p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="wrap" id="mod-body">
      <p style="font-family: var(--font-sans); color: var(--ink-soft);">加载课次中…</p>
    </div>
  </section>
</BaseLayout>

<script src="/jx-catalog.js" defer></script>
<script is:inline define:vars={{ moduleSlug }}>
  document.addEventListener('DOMContentLoaded', async () => {
    const body = document.getElementById('mod-body');
    try {
      const catalog = await JX.fetchCatalog();
      const mod = catalog.modules.find((m) => m.slug === moduleSlug);
      if (!mod) {
        body.innerHTML = '<p>未找到该模块</p>';
        return;
      }
      document.getElementById('mod-status').textContent = `学修模块 · ${mod.statusLabel || ''}`;
      document.getElementById('mod-title').textContent = `《${mod.title}》`;
      document.getElementById('mod-intro').textContent = mod.intro || mod.summary || '';
      const count = JX.lessonCount(mod);
      document.getElementById('mod-meta').textContent =
        count > 0 ? `共 ${count} 课 · 结构可在运营后台调整` : '尚未配置课次';

      if (!count) {
        body.innerHTML = `
          <div class="content-width">
            <div class="coming-box">
              <p class="coming-box__label">等待配置</p>
              <p>请运营同学在后台为本模块添加章节与课程。也可先学习 <a href="/qianxing/">《大圆满前行-讲解》</a>。</p>
              <p style="margin-top:1.5rem;"><a class="btn btn--solid" href="/xuexiu/" style="color:#f4f7f5;">返回学修目录</a></p>
            </div>
          </div>`;
        return;
      }

      let order = 0;
      body.innerHTML = (mod.chapters || [])
        .map((ch) => {
          const items = (ch.lessons || [])
            .map((les) => {
              order += 1;
              const num = String(order).padStart(2, '0');
              return `
                <li>
                  <a href="/${mod.slug}/learn/?id=${encodeURIComponent(les.slug)}">
                    <span class="lesson-list__num">${num}</span>
                    <div>
                      <h2 class="lesson-list__title">${JX.escape(les.title)}</h2>
                      <p class="lesson-list__meta">${JX.formatLessonMeta(les)}</p>
                      <p class="lesson-list__summary">${JX.escape(les.summary || '')}</p>
                    </div>
                  </a>
                </li>`;
            })
            .join('');
          return `
            <p class="group-label">${JX.escape(ch.title)}
              <span style="color:var(--ink-soft);letter-spacing:0;margin-left:0.5rem;">（${(ch.lessons || []).length} 课）</span>
            </p>
            <ul class="lesson-list">${items}</ul>`;
        })
        .join('');
    } catch (e) {
      body.innerHTML = `<p>加载失败：${JX.escape(e.message || e)}</p>`;
    }
  });
</script>
